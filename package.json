{
	"name": "obsidian-whereday-maps",
	"version": "0.7.15",
	"description": "Obsidian plugin that renders Leaflet maps inline from Whereday (formerly iso.me) location exports.",
	"repository": {
		"type": "git",
		"url": "https://github.com/CodyBontecou/whereday-maps.git"
	},
	"bugs": {
		"url": "https://github.com/CodyBontecou/whereday-maps/issues"
	},
	"homepage": "https://github.com/CodyBontecou/whereday-maps#readme",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node scripts/test.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"leaflet",
		"maps",
		"whereday",
		"iso.me"
	],
	"author": "Cody Bontecou",
	"license": "MIT",
	"devDependencies": {
		"@types/leaflet": "^1.9.21",
		"@types/node": "^22.0.0",
		"esbuild": "^0.28.0",
		"obsidian": "^1.12.0",
		"tslib": "^2.8.1",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"leaflet": "^1.9.4"
	}
}
